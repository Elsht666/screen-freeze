<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="end"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingTop="52dp"
      android:paddingEnd="16dp">

    <TextView
        android:id="@+id/about_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/about_button_background"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="44dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="@string/about_button"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
  </LinearLayout>

  <ScrollView
      android:id="@+id/buttons_container"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:fillViewport="true"
      android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingVertical="@dimen/root_padding_vertical">

      <LinearLayout
          android:id="@+id/buttons"
          android:layout_width="256dp"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:animateLayoutChanges="true"
          android:orientation="vertical">

        <ImageView
            android:id="@+id/brand_icon"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/brand_icon_content_description"
            android:minHeight="32dp"
            android:src="@drawable/brand_icon" />

        <TextView
            android:id="@+id/service_down_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/about_button_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:text="@string/service_down_banner"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/enable_button_background_tint"
            android:minWidth="192dp"
            android:padding="24dp"
            android:textAllCaps="false"
            android:textColor="@color/enable_button_text"
            android:textSize="24sp"
            android:theme="@style/EnableButton" />

        <LinearLayout
            android:id="@+id/color_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="28dp">

          <TextView
              android:id="@+id/color_label"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:text="@string/color_picker_title"
              android:textColor="#CCCCCC"
              android:textSize="14sp" />

          <View
              android:id="@+id/color_preview"
              android:layout_width="56dp"
              android:layout_height="56dp"
              android:layout_gravity="center_horizontal"
              android:layout_marginTop="10dp"
              android:background="@drawable/color_preview_oval"
              android:clickable="true"
              android:contentDescription="@string/color_picker_title"
              android:focusable="true" />
        </LinearLayout>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
