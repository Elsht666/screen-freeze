<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background_rounded"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingVertical="32dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="start"
      android:text="@string/dialog_permission_title"
      android:textColor="#FFFFFF"
      android:textSize="26sp"
      android:textStyle="bold" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:gravity="start"
      android:lineSpacingExtra="4dp"
      android:text="@string/dialog_permission_explanation"
      android:textColor="#B8C4E0"
      android:textSize="18sp" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="28dp"
      android:gravity="center"
      android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_permission_button_cancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:backgroundTint="@color/dialog_permission_button_cancel_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@animator/button_floating"
        android:text="@string/dialog_permission_button_cancel"
        android:textColor="#D0D8EE"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:strokeColor="#445577"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_permission_button_confirm"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:backgroundTint="@color/dialog_permission_button_confirm_background"
        android:elevation="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@animator/button_floating"
        android:text="@string/dialog_permission_button_confirm"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />
  </LinearLayout>
</LinearLayout>
